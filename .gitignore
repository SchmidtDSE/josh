landing/war/js
landing/war/wasm-gc
landing/d3.min.js
landing/math.min.js
landing/prism-*.js
landing/prism-*.css
landing/ace.min.js
landing/theme-textmate.js
landing/theme-textmate-css.js

# The shared browser client, staged into each site by web/stage_js.sh. One copy is tracked, at
# web/js; these are the copies each site serves. They are ignored so that editing one shows up
# as nothing in `git status`, which is the signal that the edit belongs in web/js instead.
editor/js/debug.js
editor/js/mode-joshlang.js
editor/js/model.js
editor/js/parse.js
editor/js/summarize.js
editor/js/util.js
editor/js/viz.js
editor/js/wasm.js
editor/js/wasm.worker.js
editor/js/wire.js

