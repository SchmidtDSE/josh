import "invasive_grass.josh"

update simulation Main

  fire.step = meta.stepCount == config scenario.fireStep

  exportFiles.patch = "file:///tmp/management_results_{replicate}.csv"

end simulation

update patch Default

  onFire.step = meta.fire and ((external burned at 0) > 0 count)
  inMgmtZone.step = (external managed at 0) > 0 count
  inMgmt.step = inMgmtZone and (meta.stepCount == config scenario.managementStep)

  inMgmtPlanted.step = inMgmt and (config scenario.outplantCount > 0 count)
  inMgmtInvasives.step = inMgmt and (config scenario.removeInvasives > 0 count)

  ForeverTree.init = create 10 count of ForeverTree through "founding"
  ForeverTree.step:if(inMgmtPlanted) = prior.ForeverTree | (create config scenario.outplantCount of ForeverTree through "outplant")

  nLiveTrees.step = count(ForeverTree[ForeverTree.state != "Burned"])

  invasiveCover.step = {
    const openness =
      map (limit prior.nLiveTrees to [0 count, config scenario.treesForFullSuppression])
      from [0 count, config scenario.treesForFullSuppression]
      to [100%, 0%] linear
    const grown =
      limit (prior.invasiveCover + openness * (config scenario.invasiveBaseGrowth + prior.coverImmigration))
      to [config scenario.invasiveMinCover, 100%]
    return config scenario.invasiveRemovalTarget if inMgmtInvasives else grown
  }

  export.nBurned.step = count(ForeverTree[ForeverTree.state == "Burned"])
  export.nJuvenile.step = count(ForeverTree[ForeverTree.state == "Juvenile"])
  export.nAdult.step = count(ForeverTree[ForeverTree.state == "Adult"])

end patch

update organism ForeverTree

  # Founders (planted at init) start as bare seedlings; outplants (added by management) arrive as
  # established stock. Birth is dispatched by creation origin, not by the simulation clock. Origin
  # dispatch is a pure replace: each block supplies the full birth state (including state), since a
  # create ... through runs only its own init block, not the plain (non-origin) init above.
  start init through "founding"
    age = 0 year
    height = 0 m
    state = "Adult" if height >= config scenario.smallTreeHeight else "Juvenile"
  end init

  start init through "outplant"
    age = config scenario.outplantAge
    height = config scenario.outplantHeight
    state = "Adult" if height >= config scenario.smallTreeHeight else "Juvenile"
  end init

  # One burn draw per tree; only true inside the fire footprint on the fire step.
  burned.step = here.onFire and ((sample uniform from 0% to 100%) < config scenario.burnLikelihood)

  start state "Juvenile"
    state.step
      :if(current.burned) = "Burned"
      :elif(prior.height >= config scenario.smallTreeHeight) = "Adult"
  end state

  start state "Adult"
    state.step:if(current.burned) = "Burned"
  end state

  # Killed by fire: no further growth.
  start state "Burned"
    growthInhibition.step = 0%
  end state

end organism
