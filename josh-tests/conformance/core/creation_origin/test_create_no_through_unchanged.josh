# @category: creation_origin
# @subcategory: regression
# @priority: critical
# @description: create without through runs only base init (existing models unaffected)

start simulation CreateNoThroughUnchanged

  grid.size = 10 m
  grid.low.x = 0 m
  grid.low.y = 0 m
  grid.high.x = 20 m
  grid.high.y = 20 m

  steps.low = 0 count
  steps.high = 1 count

end simulation

start patch Default

  # No `through`: base init applies; the start-init-through blocks below are inert here.
  Trees.init = create 4 count of Tree

  assert.count.step:if(meta.stepCount == 0 count) = count(Trees) == 4 count
  assert.baseState.step:if(meta.stepCount == 0 count) =
    count(Trees[Trees.state == "Base"]) == 4 count
  assert.baseProvenance.step:if(meta.stepCount == 0 count) =
    count(Trees[Trees.provenance == "none"]) == 4 count

end patch

start organism Tree

  # Base init supplies everything when no origin is given.
  state.init = "Base"
  provenance.init = "none"
  age.init = 5 years
  age.step = prior.age + 1 year

  # These origin blocks must NOT run for an untagged create.
  start init through "founding"
    state = "Adult"
    provenance = "founding"
  end init

end organism

start unit year
  alias years
  alias yr
  alias yrs
end unit
