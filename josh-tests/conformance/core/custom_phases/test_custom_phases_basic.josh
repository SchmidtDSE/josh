# @category: core
# @subcategory: custom_phases
# @priority: critical
# @description: a simulation's declared phases run in order, replacing start/step/end, and carry
#   values across timesteps through the last declared phase

start simulation CustomPhasesBasic

  grid.size = 10 m
  grid.low.x = 0 m
  grid.low.y = 0 m
  grid.high.x = 10 m
  grid.high.y = 10 m

  steps.low = 0 count
  steps.high = 1 count

  start phases
    with phase base
    then phase disturb
    then phase manage
  end phases

end simulation

start patch Default

  value.init = 0 count
  value.base = prior.value + 1 count
  value.disturb = prior.value + 1 count
  value.manage = prior.value + 1 count

  # Each declared phase sees the immediately preceding phase's same-step result via prior, and the
  # last phase's result carries forward as prior.value into the next step's first phase.
  assert.stepZeroEndsAtThree.base:if(meta.stepCount == 1 count) = prior.value == 3 count

end patch
