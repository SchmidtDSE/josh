# @category: core
# @subcategory: entity_overwrite
# @priority: critical
# @description: replace fully overwrites a prior same-named entity with its own definition

start simulation EntityReplaceBasic

  grid.size = 10 m
  grid.low.x = 0 m
  grid.low.y = 0 m
  grid.high.x = 10 m
  grid.high.y = 10 m

  steps.low = 0 count
  steps.high = 0 count

end simulation

start patch Default

  age.init = 0 count
  age.step = prior.age + 1 count

end patch

replace patch Default

  age.init = 0 count
  age.step = prior.age + 100 count

  assert.replaceUsesItsOwnFormula.step = age == 100 count

end patch
