# @category: core
# @subcategory: lifecycle
# @priority: critical
# @description: Organism state transition and dead filtering in patch .step
#
# Mirrors the canonical Joshua Tree lifecycle pattern:
#   1. Trees start as "Alive" with age 0
#   2. Trees age each step
#   3. Trees transition to "Dead" when age > 2 years
#   4. Patch filters dead trees: Tree.step = prior.Tree[prior.Tree.state != "Dead"]
#   5. Population count decreases the SAME step a tree's state transitions
#
# Timeline (5 trees, all created at init; meta.stepCount is 0-based and ages one full
# year every .step, including the first):
#   stepCount 0: age becomes 1, state stays "Alive" (1 <= 2). count=5.
#   stepCount 1: age becomes 2, state stays "Alive" (2 <= 2). count=5.
#   stepCount 2: age becomes 3, current.age > 2 so state transitions to "Dead" this
#                same step. The patch's `prior.Tree[prior.Tree.state != "Dead"]` filter
#                reads `.state` on each entity in the prior collection, and that read
#                resolves to the entity's live, current-step value (there is no separate
#                frozen "prior" snapshot of a nested entity's own attributes reachable
#                through a collection reference) - so the filter sees "Dead" immediately
#                and excludes them. count drops to 0 in the SAME step the transition
#                happens, not the step after.
#   stepCount 3+: no trees remain to re-add; count stays 0.
#
# This tests:
#   - Organism state machines work during .step
#   - Filtering by .state in patch .step handler
#   - Population management via collection filtering, including the same-step
#     transition-then-filter interaction above

start simulation TestOrganismDeadStateFiltering
  grid.size = 10 m
  grid.low = 0 m latitude, 0 m longitude
  grid.high = 10 m latitude, 10 m longitude
  grid.patch = "Default"

  steps.low = 0 count
  steps.high = 5 count
end simulation

start patch Default
  Tree.init = create 5 count of Tree

  # Filter dead trees each step — exact pattern from canonical model
  Tree.step = prior.Tree[prior.Tree.state != "Dead"]

  # Track counts via patch .step exports (these also gate the step phase)
  export.treeCount.step = count(Tree)

  # stepCount 0: age becomes 1, well under the threshold
  assert.allPresentAtStep0.step:if(meta.stepCount == 0 count) = count(Tree) == 5 count

  # stepCount 1: age becomes 2, still not > 2
  assert.allPresentAtStep1.step:if(meta.stepCount == 1 count) = count(Tree) == 5 count

  # stepCount 2: age becomes 3 and the transition + filter both happen this same step
  assert.removedAtStep2.step:if(meta.stepCount == 2 count) = count(Tree) == 0 count

  # stepCount 4: stays removed, nothing left to re-add
  assert.staysRemovedAtStep4.step:if(meta.stepCount == 4 count) = count(Tree) == 0 count
end patch

start organism Tree
  age.init = 0 year
  age.step = prior.age + 1 year

  state.init = "Alive"

  start state "Alive"
    state.step:if(current.age > 2 years) = "Dead"
  end state

  start state "Dead"
  end state
end organism

start unit year
  alias years
end unit

start unit m
  alias meter
  alias meters
end unit
