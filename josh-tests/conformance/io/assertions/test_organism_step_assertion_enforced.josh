# @category: regression
# @subcategory: organism-lifecycle
# @priority: critical
# @description: Organism .step assertions are enforced regardless of patch handler presence

# Regresses a fixed bug: when the step phase was skipped (no patch .step handler), organism
# assertions at .step were never evaluated.
#
# This test verifies indirectly: the organism has age.step which should
# advance age. A patch-level .end assertion checks mean(Tree.age).
# If step ran, age >= 1. If skipped, age == 0 and assertion fails.
#
# The organism also marks that its own .step handler actually ran, so this test independently
# confirms organism-level .step assertions themselves are evaluated (not just that some other
# .step handler advanced a value the patch happens to read).

start simulation TestOrganismStepAssertionEnforced
  grid.size = 10 m
  grid.low = 0 m latitude, 0 m longitude
  grid.high = 10 m latitude, 10 m longitude
  grid.patch = "Default"

  steps.low = 0 count
  steps.high = 3 count
end simulation

start patch Default
  Tree.init = create 1 count of Tree

  avgAge.end = mean(Tree.age)

  # Patch-level check: if organism .step ran, age should be >= 1 by step 3.
  # BUG: age stays 0 because step phase is skipped.
  assert.ageAdvanced.end:if(meta.stepCount == 3 count) = current.avgAge >= 1 year

end patch

start organism Tree
  age.init = 0 year
  age.step = prior.age + 1 year

  # Marks that this organism's own .step handlers actually ran; stays 0 if the step phase is
  # skipped (the regression this test guards against).
  stepRan.init = 0 count
  stepRan.step = 1 count

  assert.stepRanOnOrganism.end:if(meta.stepCount == 3 count) = current.stepRan == 1 count
end organism

start unit year
  alias years
end unit

start unit m
  alias meter
  alias meters
end unit
