FROM eclipse-temurin:21-jre

# Mitigation for Java4Shell (AVX-512 Base64 intrinsic out-of-bounds write).
# Set via JAVA_TOOL_OPTIONS so it applies to every JVM launched in the image,
# including the shell entrypoints. Remove once the base image has a patched JDK.
ENV JAVA_TOOL_OPTIONS="-XX:-UseBASE64Intrinsics"

WORKDIR /app

COPY build/libs/joshsim-fat.jar /app/joshsim-fat.jar
COPY cloud-img/run-entrypoint.sh /app/run-entrypoint.sh
COPY cloud-img/preprocess-entrypoint.sh /app/preprocess-entrypoint.sh
RUN chmod +x /app/run-entrypoint.sh /app/preprocess-entrypoint.sh

# Default entrypoint is run. KubernetesPreprocessTarget overrides the
# container command to /app/preprocess-entrypoint.sh for preprocessing jobs.
ENTRYPOINT ["/app/run-entrypoint.sh"]
