
FROM quay.io/lib/eclipse-temurin:21

# Mitigation for Java4Shell (AVX-512 Base64 intrinsic out-of-bounds write).
# Set via JAVA_TOOL_OPTIONS so it applies to every JVM launched in the image,
# including the shell entrypoints. Remove once the base image has a patched JDK.
ENV JAVA_TOOL_OPTIONS="-XX:-UseBASE64Intrinsics"

WORKDIR /app

COPY joshsim-fat.jar /app/

EXPOSE 8085

CMD ["java", "-Xmx8g", "-jar", "joshsim-fat.jar", "server", "--port=8085", "--concurrent-workers=10", "--use-http2=true", "--worker-url=\"https://josh-executor-dev-1007495489273.us-west1.run.app/runReplicate\""]
