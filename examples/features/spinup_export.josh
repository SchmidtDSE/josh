start simulation SpinupExport

  grid.size = 10 m
  grid.low = 0 m latitude, 0 m longitude
  grid.high = 10 m latitude, 10 m longitude

  steps.low = 0 count
  steps.high = 2 count

  exportFiles.patch = "file:///tmp/spinup_export_josh.csv"

  start spinup
    duration = 2 count
  end spinup

  start spindown
    duration = 2 count
  end spindown

end simulation

start patch Default

  export.phase.step = meta.phase

end patch
