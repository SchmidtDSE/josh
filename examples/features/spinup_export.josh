start simulation SpinupExport

  grid.size = 10 m
  grid.low = 0 m latitude, 0 m longitude
  grid.high = 10 m latitude, 10 m longitude

  # 2 steps of spin-up, 3 observed steps (0..2), 2 steps of spin-down. See spinup.josh for the
  # recipe explanation -- steps.low/steps.high are widened directly and "state" marks the phase.
  steps.low = -2 count
  steps.high = 4 count

  exportFiles.patch = "file:///tmp/spinup_export_josh.csv"

  state.init = "spinup"
  state.step
    :if(meta.stepCount == 2 count) = "observed"
    :elif(meta.stepCount == 5 count) = "spindown"

end simulation

start patch Default

  export.state.step = meta.state

end patch
