start simulation SpinupExample

  grid.size = 1 m
  grid.low = 0 m latitude, 0 m longitude
  grid.high = 2 m latitude, 2 m longitude

  steps.low = 0 count
  steps.high = 4 count

  start spinup
    duration = 3 count
  end spinup

  start spindown
    duration = 2 count
  end spindown

  year.step
    :if(meta.phase == "spinup") = sample discrete uniform from 0 count to 4 count
    :elif(meta.phase == "spindown") = sample discrete uniform from 3 count to 4 count
    :else = meta.stepCount

end simulation

start patch Default

  assert.spinupStepNegative.step:if(meta.phase == "spinup") = meta.stepCount < 0 count
  assert.spinupYearLow.step:if(meta.phase == "spinup") = meta.year >= 0 count
  assert.spinupYearHigh.step:if(meta.phase == "spinup") = meta.year <= 4 count

  assert.observedStepLow.step:if(meta.phase == "observed") = meta.stepCount >= 0 count
  assert.observedStepHigh.step:if(meta.phase == "observed") = meta.stepCount <= 4 count
  assert.observedYearLow.step:if(meta.phase == "observed") = meta.year >= 0 count
  assert.observedYearHigh.step:if(meta.phase == "observed") = meta.year <= 4 count

  assert.spindownStep.step:if(meta.phase == "spindown") = meta.stepCount > 4 count
  assert.spindownYearLow.step:if(meta.phase == "spindown") = meta.year >= 3 count
  assert.spindownYearHigh.step:if(meta.phase == "spindown") = meta.year <= 4 count

end patch
